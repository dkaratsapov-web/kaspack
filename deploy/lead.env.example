# Скопировать в /etc/kaspack/lead.env и заполнить. Файл не коммитить.
LEAD_PORT=3001
ALLOWED_ORIGIN=https://kaspack.ru

# Telegram: бот от @BotFather, chat_id чата отдела продаж
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# amoCRM: домен вида kaspack.amocrm.ru и долгосрочный токен интеграции
AMO_DOMAIN=
AMO_TOKEN=
AMO_PIPELINE_ID=

# Почта
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_EMAIL_TO=info@kaspack.ru
